{
  "name": "strava-mcp-server",
  "version": "4.2.0",
  "description": "MCP server for the Strava API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "strava-mcp-server": "dist/index.js",
    "strava-mcp-auth": "dist/auth-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "tsc",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "test": "tsx --test 'test/**/*.test.ts'",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "docs:gen": "tsx scripts/gen-tools.ts && tsx scripts/gen-schema.ts",
    "docs:build": "mkdocs build --strict",
    "bench": "node scripts/bench-memory.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@hono/node-server": "^2.1.3",
    "@mapbox/polyline": "^1.2.1",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "gpx-builder": "^6.0.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
