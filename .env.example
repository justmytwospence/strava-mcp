# Strava API application (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=12345
# Strava API application client secret
STRAVA_CLIENT_SECRET=your-client-secret
# Refresh token from the OAuth flow, with activity:read_all,activity:write scopes
STRAVA_REFRESH_TOKEN=your-refresh-token
# Optional: a current access token (one is minted from the refresh token otherwise)
STRAVA_ACCESS_TOKEN=
# Optional: metric or imperial (defaults to the athlete's preference)
STRAVA_UNITS=
# Optional: comma-separated hostnames clients use, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=
