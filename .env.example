# strava-mcp configuration. Copy to .env next to compose.yaml.
#
# Compose reads this file twice: to interpolate compose.yaml (ports, profiles, memory)
# and, through env_file, to pass every line to the strava-mcp container. So any server
# variable from https://justmytwospence.github.io/strava-mcp/configuration/ can be set
# here, even ones not listed. Keep the file private: the profile sections below put
# their secrets in the server's environment too.
#
# Only the three variables marked (required) need a value. A variable left empty is
# the same as unset.

# --- Strava API application (required) -------------------------------------------------
# Create one at https://www.strava.com/settings/api with Authorization Callback Domain
# set to "localhost", then run the one-time authorization:
#   docker compose run --rm -p 8765:8765 strava-mcp auth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: a refresh token from your own OAuth flow, used only when the token file does
# not exist yet. Not needed after `strava-mcp auth`.
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=

# Port the authorization command listens on for Strava's redirect
# (http://localhost:<port>/callback). Publish the same port: -p <port>:<port>.
STRAVA_AUTH_PORT=8765

# --- MCP endpoint (required) -------------------------------------------------------------
# Bearer token clients must send to /mcp. Generate one: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Host port for the server (http://<host>:8000/mcp).
STRAVA_MCP_PORT=8000

# Hostnames clients use to reach the server, comma-separated, e.g. strava.example.com.
# Unset accepts any Host header; set it when the server is reachable through a reverse proxy.
MCP_ALLOWED_HOSTS=

# --- Snapshot, export and sync (optional) ----------------------------------------------
# Serve the read-only snapshot at GET /snapshot.duckdb and the live export at
# GET /export/sync (starred routes and recent activities, for garmin-mcp and the like) to
# this bearer token. Unset: neither is served; the grafana and notebooks profiles read
# the snapshot file from the volume and do not need it.
SNAPSHOT_TOKEN=

# Public HTTPS URL for Strava's push events, with a secret path, e.g.
# https://strava.example.com/webhook/4f1c0e3b9a. Unset: new activities are found by polling
# every 15 minutes. See the docs for tunnel and reverse-proxy recipes.
STRAVA_WEBHOOK_URL=

# on (default) keeps the mirror in sync in the background; off only answers from the mirror
# and fetches what tools ask for.
STRAVA_SYNC=on

# How often the route list is refreshed, in minutes (default 60, minimum 5). Strava sends
# no event for starring or unstarring a route; lower this (e.g. 15) when something acts on
# the starred flag promptly, such as garmin-mcp's course cleanup reading /export/sync.
STRAVA_ROUTES_INTERVAL_MINUTES=60

# metric or imperial for the prompts' formatting; unset uses the athlete's Strava preference.
STRAVA_UNITS=

# Strava's new base URL, https://api-v3.strava.com, is available from 2027-01-04
# (https://developers.strava.com/docs/changelog/); set it here to switch early.
STRAVA_API_BASE=https://www.strava.com/api/v3

# --- Paths and transport (image defaults; change only with a Compose override) -----------
# STRAVA_DB_PATH=/data/strava.duckdb
# STRAVA_SNAPSHOT_DIR=/data/snapshot
# STRAVA_TOKEN_FILE=/data/tokens.json
# MCP_TRANSPORT=http
# PORT=8000

# --- Resources (optional) ---------------------------------------------------------------
# DuckDB's memory limit and threads inside the container, and the container's memory limit.
# 384MB / 1g fits a mirror of about 2,000 activities with full streams; see the operations
# guide before changing them.
DUCKDB_MEMORY_LIMIT=384MB
DUCKDB_THREADS=2
STRAVA_MCP_MEMORY=1g

# --- Profile: oauth (docker compose --profile oauth up -d) --------------------------------
# OAuth 2.1 in front of /mcp with any OIDC provider (Authelia, Authentik, Keycloak, Pocket ID,
# ...). PUBLIC_URL is where your TLS reverse proxy exposes port OAUTH_PORT. All four of
# OIDC_ISSUER, OIDC_JWKS_URL, OIDC_CLIENT_ID and PUBLIC_URL are required by the profile.
OIDC_ISSUER=
# JWKS endpoint of the provider; there is no default because every provider uses a
# different path. It is the jwks_uri in <issuer>/.well-known/openid-configuration, e.g.
#   Authelia   https://auth.example.com/jwks.json
#   Authentik  https://auth.example.com/application/o/<slug>/jwks/
#   Keycloak   https://keycloak.example.com/realms/<realm>/protocol/openid-connect/certs
#   Pocket ID  https://id.example.com/.well-known/jwks.json
OIDC_JWKS_URL=
# The client registered at the provider for this server.
OIDC_CLIENT_ID=
# Audience expected in access tokens; default OIDC_CLIENT_ID.
OIDC_AUDIENCE=
PUBLIC_URL=
OAUTH_PORT=3000
# Largest JSON-RPC body accepted by the gateway, in bytes (uploads are the only large ones).
MCP_BUFFER=33554432

# --- Profile: grafana ---------------------------------------------------------------------
# Published on 127.0.0.1 only by default, because of the default login; set
# GRAFANA_BIND=0.0.0.0 and a real password to reach it from other machines.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Profile: notebooks -------------------------------------------------------------------
# The notebook runs without a token, so it is published on 127.0.0.1 only by default; set
# MARIMO_BIND=0.0.0.0 to reach it from other machines, behind something that authenticates.
MARIMO_BIND=127.0.0.1
MARIMO_PORT=2718

# --- Profile: backup ----------------------------------------------------------------------
# Where archives go on the host, how often (cron, UTC), and how long they are kept.
BACKUP_DIR=./backups
BACKUP_CRON_EXPRESSION=0 4 * * *
BACKUP_RETENTION_DAYS=14
