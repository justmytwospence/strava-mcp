# strava-mcp configuration. Copy to .env next to compose.yaml; compose reads it.
# Only the three variables marked (required) need a value.

# --- Strava API application (required) -------------------------------------------------
# Create one at https://www.strava.com/settings/api with Authorization Callback Domain
# set to "localhost", then run the one-time authorization:
#   docker compose run --rm -p 8765:8765 strava-mcp auth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: a refresh token from your own OAuth flow, used only when the token file does
# not exist yet. Not needed after `strava-mcp auth`.
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=

# --- MCP endpoint (required) -------------------------------------------------------------
# Bearer token clients must send to /mcp. Generate one: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Host port for the server (http://<host>:8000/mcp).
STRAVA_MCP_PORT=8000

# Hostnames clients use to reach the server, comma-separated, e.g. strava.example.com.
# Unset accepts any Host header; set it when the server is reachable through a reverse proxy.
MCP_ALLOWED_HOSTS=

# --- Snapshot and sync (optional) -------------------------------------------------------
# Serve the read-only snapshot at GET /snapshot.duckdb to this bearer token (for your own
# DuckDB clients over HTTP). Unset: not served; the grafana and notebooks profiles read the
# file from the volume and do not need it.
SNAPSHOT_TOKEN=

# Public HTTPS URL for Strava's push events, with a secret path, e.g.
# https://strava.example.com/webhook/4f1c0e3b9a. Unset: new activities are found by polling
# every 15 minutes. See the docs for tunnel and reverse-proxy recipes.
STRAVA_WEBHOOK_URL=

# on (default) keeps the mirror in sync in the background; off only answers from the mirror
# and fetches what tools ask for.
STRAVA_SYNC=on

# metric or imperial for the prompts' formatting; unset uses the athlete's Strava preference.
STRAVA_UNITS=

# Strava moves the API to https://api-v3.strava.com (available from 2027-01-04).
STRAVA_API_BASE=https://www.strava.com/api/v3

# --- Resources (optional) ---------------------------------------------------------------
# DuckDB's memory limit and threads inside the container, and the container's memory limit.
# 384MB / 1g fits a mirror of about 2,000 activities with full streams; see the operations
# guide before changing them.
DUCKDB_MEMORY_LIMIT=384MB
DUCKDB_THREADS=2
STRAVA_MCP_MEMORY=1g

# --- Profile: oauth (docker compose --profile oauth up -d) --------------------------------
# OAuth 2.1 in front of /mcp with any OIDC provider (Authelia, Authentik, Keycloak, Pocket ID,
# ...). PUBLIC_URL is where your TLS reverse proxy exposes port OAUTH_PORT.
OIDC_ISSUER=
# JWKS endpoint; default ${OIDC_ISSUER}/jwks.json (Authelia). Keycloak:
# ${OIDC_ISSUER}/protocol/openid-connect/certs; Authentik: ${OIDC_ISSUER}/jwks/;
# Pocket ID: ${OIDC_ISSUER}/.well-known/jwks.json
OIDC_JWKS_URL=
# The client registered at the provider for this server.
OIDC_CLIENT_ID=
# Audience expected in access tokens; default OIDC_CLIENT_ID.
OIDC_AUDIENCE=
PUBLIC_URL=
OAUTH_PORT=3000
# Largest JSON-RPC body accepted by the gateway, in bytes (uploads are the only large ones).
MCP_BUFFER=33554432

# --- Profile: grafana ---------------------------------------------------------------------
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Profile: notebooks -------------------------------------------------------------------
MARIMO_PORT=2718

# --- Profile: backup ----------------------------------------------------------------------
# Where archives go on the host, how often (cron, UTC), and how long they are kept.
BACKUP_DIR=./backups
BACKUP_CRON_EXPRESSION=0 4 * * *
BACKUP_RETENTION_DAYS=14
